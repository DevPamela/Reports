@model ClassroomViewModel

<br />
<br />
<br />
<h3>Para começar, selecione a turma que você deseja escrever os relatórios</h3>
<br/>
<br />
@using (Html.BeginForm("SetIsSelectedPropertyAstrue", "Classroom"))
{
    @for (int i = 0; i < Model.Classes.Count; i++)
    {
        <div>
            <label>
                <h2>
                @Html.HiddenFor(m => m.Classes[i].Id)
                @Html.HiddenFor(m => m.Classes[i].Name)
                <input type="checkbox" name="SelectedClasses" value="@Model.Classes[i].Id" />
                @Html.DisplayFor(m => m.Classes[i].Name)
                </h2>
            </label>
        </div>
    }
    <br />
    <div style="display: flex; gap: 10px;">
        <input type="submit" value="Enviar" class="btn btn-primary" />
        <button type="button" onclick="window.history.back()" class="btn btn-primary">Voltar</button>
    </div>
}