@using Reports.Application.Enums
@using Reports.Domain.Models.Responses
@model AddStudentViewModel
@{
    ViewData["Title"] = "AddStudent";
}
<br/>
<br />
<br />
<h4>Adicionar novo aluno</h4>
<br />

<h4>Preencha os dados abaixo e adicione seu novo aluno à lista existente</h4>
<br />
<div asp-validation-summary="All" id="validation-errors" class="d-flex justify-content-start text-danger"></div>
<form id="add-new-student-form" asp-controller="Student" asp-action="AddNewStudent" method="post" class="col-md-5">
    <div class="mb-3">
        <label for="name" class="form-label">NOME</label>
        <input id="name" type="text" asp-for="Name" class="form-control">
    </div>
    
    <div class="mb-3">
        <label for="birthdate" class="form-label">DATA DE NASCIMENTO</label>
        <input id="birthdate" type="date" asp-for="Birthdate" class="form-control">
    </div>
    
    <div class="mb-3">
            <label for="gender" class="form-label">GÊNERO</label>
            <select id="gender" asp-for="Gender" asp-items="@Html.GetEnumSelectList<Gender>()" class="form-select">
                <option value="" disabled selected>Selecione o gênero</option>
            </select>
        </div>
    
    <div class="mb-3">
        <label for="classroom" class="form-label">TURMA</label>
        <select id="classroom" 
                asp-for="ClassroomId"  
                asp-items="@(new SelectList(
                               Model.Classrooms, 
                               nameof(ClassroomNameResponse.Id), 
                               nameof(ClassroomNameResponse.Name)))"
                class="form-select">
            <option value="" disabled selected>Selecione a turma</option>
        </select>
    </div>
    
    <input id="submit-button" type="submit" class="btn btn-primary" value="Enviar" />
</form>