@model ClassroomAndStudentViewModel
@using Reports.Domain.Entities.Responses
@{
    ViewData["Title"] = "AddStudent";
}
<br/>
<br />
<br />
<h4>Adicionar novo aluno</h4>

<br />

<h4>Preencha os dados abaixo e adicione seu novo aluno à lista existente</h4>

<form asp-controller="Student" asp-action="AddStudent" method="post">
    <div class="form-group col-md-5">
        <br />
    @Html.AntiForgeryToken()
      
        <label for="Nome" class="form-label">NOME</label>
        <input type="text" asp-for="Student.Name" class="form-control">
    </div>
   
    <div class="form-group">
        <label for="Nome" class="form-label">GÊNERO</label>
        <select name="Student.Gender" style="width: 10em;" maxlength="10">
            <option value="FEMININO">FEMININO</option>
            <option value="MASCULINO">MASCULINO</option>
        </select>
    </div>
    <div class="form-group col-md-3">
        <label for="Nome" class="form-label">DATA DE NASCIMENTO</label>
        <input type="date" asp-for="Student.Birthdate" id="dataNascimento"
               class="form-control" onkeydown="return false">
    </div>
    <div class="form-group">
        <label for="Class" class="form-label">TURMA</label>
        <select name="Student.ClassRoomId" class="form-control" style="width: 10em;" maxlength="10">
            @foreach (var item in Model.Classes)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
    </div>
    <br />

    <button type="submit">Enviar</button>
    <a href="javascript:history.back()" class="btn btn-secondary mt-3">Voltar</a>
</form>