@using (Html.BeginForm("SaveStudentGender", "Student", FormMethod.Post))
{
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Data de nascimento</th>
                <th>Gênero</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Students.Count; i++)
            {
                <tr>
                    <td>
                        @Html.HiddenFor(m => m.Students[i].Name)
                        @Html.DisplayFor(m => m.Students[i].Name)
                    </td>
                    <td>
                        @Html.HiddenFor(m => m.Students[i].Birthday)
                        @Model.Students[i].Birthday.ToString("dd/MM/yyyy")
                    </td>
                    <td>
                        @Html.DropDownListFor(m => m.Students[i].Genre, new List<SelectListItem>
                {
                new SelectListItem { Text = "Masculino", Value = "Masculino" },
                new SelectListItem { Text = "Feminino", Value = "Feminino" }
                }, new { @maxlength = 1 })
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit">Enviar</button>
}