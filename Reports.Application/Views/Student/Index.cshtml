@section Scripts{
    <script>
        function RegisterStudentByList() {
            const input = document.getElementById("inputExcel");
            const classroomName = document.getElementById("classroomName").value;
            // Verifica se um arquivo foi selecionado
            if (input.files.length > 0) {
                const formData = new FormData();
                formData.append("excelFile", input.files[0]);
                formData.append("classroomName", classroomName);

                fetch("/Student/RegisterStudentByList", {
                    method: "POST",
                    body: formData
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Erro ao enviar arquivo.');
                        }
                        return response.json();
                    })
                    .then(dataJson => {
                        console.log(dataJson);
                        window.location.href = dataJson.redirectUrl;
                    })
                    .catch(error => {
                        console.error('Erro:', error);
                        window.location.href = "/Student/Error";
                    });
            } else {
                alert("Por favor, selecione um arquivo antes de enviar.");
            }
        }
    </script>
    }


