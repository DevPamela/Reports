@model StudentViewModel

<br />
<br />
<h1>Selecione os alunos que você deseja escrever relatório</h1>
<br />
<br />
<input type="checkbox" id="select-all" /> SELECIONAR TODOS
<br />
<br />
@using (Html.BeginForm("SetIsSelectedPropertyStudentAstrue", "Student"))
{
    @for (int i = 0; i < Model.Students.Count; i++)
    {
        <div>
            <label>
                
                @Html.HiddenFor(m => m.Students[i].Id)
                @Html.HiddenFor(m => m.Students[i].Name)
                <input type="checkbox" class="student" name="studentsId" value="@Model.Students[i].Id" />
                @Html.DisplayFor(m => m.Students[i].Name)
            </label>
        </div>
    }
    <br />
    <button type="submit" class="btn btn-primary">Enviar</button>
}
<script>
    document.getElementById('select-all').addEventListener('change', function () {
        const checkboxes = document.querySelectorAll('.student');
        checkboxes.forEach(checkbox => {
            checkbox.checked = this.checked;
        });
    });
</script>
