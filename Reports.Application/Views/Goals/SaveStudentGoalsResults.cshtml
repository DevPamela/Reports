@using Reports.Domain.Entities;
@model List<Student>
<br/>

<br />
<h1>Agora, atribua sua avaliação de cada objetivo traçado para cada aluno. As opções são:<br/>
    Satisfatório, Parcialmente satisfatório e insatisfatório</h1>
    <h2>Atenção, essa etapa é muito importante, a seleção do objetivo para o aluno, vai determinar o parágrafo que será escrito para o relatório individual, caso não preencha o valor usado para todos os alunos selecionados será satisátório</h2>
@using (Html.BeginForm("SaveIsAtendedInformation", "Goals", FormMethod.Post))
{
    <table border="1">
        <tr>
            <th>Nome</th>
            @{
                var uniqueGoals = Model.SelectMany(e => e.Goals).Select(g => g.Name).Distinct();
            }
            @foreach (var goalName in uniqueGoals)
            {
                <th class="vertical-text">@goalName</th>
            }
        </tr>
        @for (int i = 0; i < Model.Count; i++)
        {
            var student = Model[i];
            <tr>
                <td>@student.Name</td>
                @for (int j = 0; j < student.Assessments.Count; j++)
                {
                    var assessment = student.Assessments[j];
                    <td>
                        <input type="hidden" name="Students[@i].Assessments[@j].StudentId" value="@assessment.StudentId" />
                        <input type="hidden" name="Students[@i].Name" value="@student.Name" />
                        <input type="hidden" name="Students[@i].Assessments[@j].GoalId" value="@assessment.GoalId" />
                        <select name="Students[@i].Assessments[@j].IsSatisfactory" style="width: 2em;" maxlength="1">
                            <option value="S">S - Satisfatório</option>
                            <option value="PS">PS - Parcialmente Satisfatório</option>
                            <option value="I">I - Insatisfatório</option>
                        </select>
                    </td>
                }
            </tr>
        }
    </table>

    <br />
    <div style="display: flex; gap: 10px;">
        <input type="submit" value="Próximo" class="btn btn-primary" />
        <button type="button" onclick="window.history.back()" class="btn btn-primary">Voltar</button>
    </div>
}