<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Minha Aplicação</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Alternar navegação">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/">Home</a>
                </li>

                @* Verifica se o usuário está autenticado *@
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/Perfil">Meu Perfil</a>
                    </li>

                    @* Verifica se o usuário tem informações completas *@
                    var mostrarMenuCompleto = ViewBag.MostrarMenuCompleto as bool?;

                    if (mostrarMenuCompleto == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/SecaoRestrita">Seção Restrita</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning" href="/PreencherDados">Preencher Dados</a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link text-danger" href="/Logout">Sair</a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/User/Login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/User/Register">Registrar</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
