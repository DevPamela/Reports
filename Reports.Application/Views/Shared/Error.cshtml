@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Use the shared layout
}

<div class="container text-center my-5">
    <h1 class="display-1 text-danger">Ops!</h1>
    <h2 class="text-muted">Algo deu errado.</h2>

    <p class="lead text-muted">Ocorreu um erro ao processar sua solicitação.</p>

    @if (Model.StatusCode.HasValue)
    {
        <p class="text-muted">
            <strong>Código de Status:</strong> @Model.StatusCode
        </p>
    }

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <p class="text-muted">
            <strong>Mensagem:</strong> @Model.Message
        </p>
    }

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            <strong>ID da Solicitação:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <p class="text-muted">
        Se você continuar vendo este erro, entre em contato com o suporte ou tente novamente mais tarde.
    </p>

    <a href="/" class="btn btn-primary mt-3">Ir para a Página Inicial</a>
    <a href="javascript:history.back()" class="btn btn-secondary mt-3">Voltar</a>
</div>
