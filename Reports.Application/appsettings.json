{
  "Serilog": {
    "AllowedHosts": "*",

    "CustomSettings": {
      "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
    },
    "MinimumLevel": "Debug", // Serilog's minimum level
    "OpenIddict": {
      "Authority": "https://localhost:44399",
      "Issuer": "https://localhost:44399"
    },
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File" }
    ]
  },
  "Session": {
    "IdleTimeoutMinutes": 20
  },
  "OpenIddict": {
    "AuthorizationEndpoint": "/connect/authorize", // Authorization endpoint URL
    "TokenEndpoint": "/connect/token", // Token endpoint URL
    "LogoutEndpoint": "/connect/logout", // Logout endpoint URL
    "AccessTokenLifetimeMinutes": 60, // Access token lifetime
    "Issuer": "https://yourdomain.com" // Important: Your domain! (Or localhost for dev)
  },

  "Authentication": {
    "LoginPath": "/User/Login", // Path to your login page
    "LogoutPath": "/User/Logout" // Path to your logout page
  },

  "ConnectionStrings": {
    "ReportsConnection": "Server=localhost;Port=3307;Database=reportsdb;User=admin_user_api;Password=EvloSEd3d5&*;"
  }
}
