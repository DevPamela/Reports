        void Add(ClassRoom classRoom);

        /// <summary>
        /// Retrieve all <see cref="ClassRoom"/> from data store.
        /// </summary>
        /// <returns></returns>
        Task<List<ClassRoom>> GetAllAsync();

        /// <summary>
        /// Retrieve one <see cref="ClassRoom"/>by name.
        /// </summary>
        /// <param name="name"></param>
        /// <returns></returns>
